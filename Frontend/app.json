{
  "expo": {
    "name": "SaOT",
    "slug": "saot",
    "version": "0.1.0",
    "scheme": "saot",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "backgroundColor": "#000000",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.saot.mobile",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        }
      }
    },
    "android": {
      "package": "app.saot.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#000000"
      }
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-camera",
        {
          "cameraPermission": "SaOT necesita acceso a tu cámara para escanear códigos QR de pago."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "SaOT usa Face ID para confirmar tus pagos de forma segura."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "SaOT necesita acceso a tus fotos para que elijas tu foto de perfil."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}